# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API)
# ---------------------------------------------------------------------------
# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import into a client component, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Used by `supabase link` / `supabase db push`
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public origin, used to build QR / ID-card links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Display timezone for all dates/times shown to users.
NEXT_PUBLIC_SCHOOL_TIMEZONE=Asia/Dhaka
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ---------------------------------------------------------------------------
# SMS provider  (sms.bd or compatible) — SERVER ONLY
# ---------------------------------------------------------------------------
# simulate = log to database only, send nothing. live = actually send.
SMS_MODE=simulate
SMS_PROVIDER=smsbd
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_BASE=https://sms.bd/api

# ---------------------------------------------------------------------------
# K40 fingerprint bridge — shared secret the on-site sync service uses to
# authenticate when POSTing punch logs. Generate a long random value.
# ---------------------------------------------------------------------------
K40_BRIDGE_SHARED_SECRET=
