{
  "name": "school-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/access-rules.test.mjs tests/admission.test.mjs tests/phone.test.ts tests/sms.test.ts",
    "test:watch": "vitest",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:seed": "node scripts/verify-seed.mjs",
    "verify": "npm run typecheck && npm run lint && npm run verify:seed && npm run test",
    "db:link": "supabase link --project-ref",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:seed": "supabase db push --include-seed",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "test:local": "vitest run tests/access-rules.test.mjs tests/admission.test.mjs tests/phone.test.ts tests/sms.test.ts",
    "test:remote": "vitest run tests/remote-access.test.ts tests/remote-storage.test.ts tests/remote-otp.test.ts",
    "test:remote:cleanup": "node scripts/remote-cleanup.mjs",
    "check:env": "node scripts/check-env.mjs",
    "report:remote-schema": "node scripts/remote-schema-report.mjs",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
